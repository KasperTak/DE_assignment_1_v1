{
  "steps": [
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "gcloud",
      "args": [
        "storage",
        "cp",
        "gs://${_MODEL_REPO}/dtr/dtr_model.pkl",
        "./prediction-api/testResources/dtr_dtr_model.pkl"     
      ]
    },		
	{
      "name": "python:3.12.7",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "cd ./prediction-api && python -m venv .myenv && . .myenv/bin/activate && python -m pip install --upgrade pip && python -m pip install -r requirements.txt && python -m pytest --junitxml=${SHORT_SHA}_test_log.xml ./tests"
      ]
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "gcloud",
      "args": [
        "storage",
        "cp",
        "gs://${_MODEL_REPO}/linr/linr_model.pkl",
        "./prediction-api/model.pkl"
      ]
    },	
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "-t",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-api:0.0.1",
        "./prediction-api"
      ]
    },    
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "push",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-api:0.0.1"
      ]
    },
	{
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "-t",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-ui:0.0.1",
        "./prediction-ui"
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "push",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-ui:0.0.1"
      ]
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "gcloud",
      "args": [
        "run",
        "deploy",
        "prediction-api",
        "--image",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-api:0.0.1",
        "--region",
        "us-central1",
        "--platform",
        "managed",
        "--port",
        "5000",
        "--cpu",
        "2",
        "--memory",
        "4G",
        "--allow-unauthenticated"
      ],
      "id": "prediction-api-deploy"
    },
    {
      "name": "ubuntu",
      "args": [
        "sleep",
        "60"
      ],
      "waitFor": [
        "prediction-api-deploy"
      ],
      "id": "sleep-delay"
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "gcloud run services list --platform managed | grep  https://prediction-api | awk '{print $4}' > /workspace/api_url.text"
      ],
      "waitFor": [
        "sleep-delay"
      ],
      "id": "api-url-extraction"
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "gcloud run deploy prediction-ui --image ${_LOCATION}-docker.pkg.dev/${PROJECT_ID}/${_REPOSITORY}/prediction-ui:0.0.1 --set-env-vars PREDICTOR_API=$(cat /workspace/api_url.text)/house_price_predictor --region us-central1 --platform managed --port 5000 --cpu 2 --memory 4G --allow-unauthenticated"
      ],
      "waitFor": [
        "api-url-extraction"
      ]
    }
  ],
  "artifacts": {
    "objects": {
      "location": "gs://${_TEMP_REPO}/",
      "paths": [
        "/workspace/api_url.text"
      ]
    }
  },
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
