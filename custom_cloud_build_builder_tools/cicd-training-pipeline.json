{
  "steps": [
    {
      "name": "python:3.12.7",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "cd ml-pipeline && pip install -r requirements.txt && python dtr_linr_train_pipeline.py"
      ]
    },
    {
      "name": "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/pipeline-executor:0.0.1",
      "args": [
        "--name=houseprice-predictor-training-pipeline",
        "--pipeline_def=./ml-pipeline/houseprice_predictor_training_pipeline.yaml",
        "--pipeline_root=gs://${_TEMP_REPO}",
        "--parameter_dict=./ml-pipeline/pipeline_parameters.json"
      ]
    }
  ],
  "timeout": "3600s",
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
